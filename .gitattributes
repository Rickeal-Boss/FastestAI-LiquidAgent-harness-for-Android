* text=auto

# 源码与文档一律 LF。旧仓实测：Windows 工作树若按 CRLF 提交，shell 判据与
# 行尾锚定的正则会在 CI（Linux）上失效。
*.kt   text eol=lf
*.kts  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.toml text eol=lf
*.pro  text eol=lf

gradlew text eol=lf
gradlew.bat text eol=crlf

# 二进制
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.apk binary
*.p12 binary
*.keystore binary
