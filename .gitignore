# ---- Python（止损台脚本）----
__pycache__/
*.pyc

# ---- 提交信息草稿（一次性）----
_commit_*.txt
_*commit*msg*.txt

# ---- 波次取证 / 一次性脚本（含本机路径的取证脚本、redact 脚本、提交草稿，永不入库；
# ---- W44 起 gitignore 兜底：这些文件从不走 git add -f，绕过脱敏复核的场景本身消失）----
_w[0-9]*/
_w[0-9][A-Za-z0-9_]*.py
_w[0-9][A-Za-z0-9_]*.txt
_w[0-9][A-Za-z0-9_]*.sh
