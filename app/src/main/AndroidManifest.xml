<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 远程引擎 / MCP 传输需要出网。本仓是纯 API 的 Agent Harness：
         模型在云端，所有推理请求都要出网，仓内不存在端侧推理，也不做任何数据外发之外的本地计算。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 明文策略必须显式声明（G15b）：minSdk 31 默认禁明文，而预置 Ollama 端点是
         http://10.0.2.2:11434 —— 不写 networkSecurityConfig 该预置必然连不通。
         白名单只有 10.0.2.2 / 127.0.0.1 / localhost，见 res/xml/network_security_config.xml。 -->
    <!-- Application 子类只持有 AppContainer（手写 DI）；不在字段初始化期取系统服务
         （旧仓 W78 的 NPE 打死进程事故）。 -->
    <!-- allowBackup="false" 是第一道闸；dataExtractionRules 是第二道（G15c 两条一起钉）：
         即使有人把 allowBackup 改回 true，密钥密文 / 端点清单 / 日志 / datastore 也不会
         被云备份或换机迁移带走 —— Keystore 密钥不随迁，带走只会制造「显示已配置但 401」
         的假象。理由逐条写在 res/xml/data_extraction_rules.xml 里。 -->
    <application
        android:name=".LiquidHarnessApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidHarness"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LiquidHarness"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
