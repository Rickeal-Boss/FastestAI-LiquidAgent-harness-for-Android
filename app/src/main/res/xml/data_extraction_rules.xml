<?xml version="1.0" encoding="utf-8"?>
<!--
  备份 / 换机迁移的排除面（配合 AndroidManifest 的 android:dataExtractionRules）。

  为什么必须有这个文件，即使 manifest 已经写了 android:allowBackup="false"：
  allowBackup=false 关掉的是默认行为，不是能力。它是 manifest 里的一个布尔属性，
  一次「顺手打开」的改动（或某个 OEM 迁移工具对它的忽略）就能让整个私有目录被带走。
  守卫 G15c 因此同时钉两件事：allowBackup=false 与本文件的存在 + 关键词。
  这是第二道闸，不是重复劳动：第一道是开关，第二道是开关被打开时仍然不带密钥走。

  为什么这几条必须排除（不是「敏感一点所以排除」，是「迁过去必然坏」）：
  * harness/secrets/：API Key 的 Keystore 信封密文（iv || ciphertext）。
    AndroidKeyStore 里的密钥不随任何备份 / 迁移通道走（它绑设备、绑 TEE）。
    所以旧密文到了新机必然解不开（AEADBadTagException），EndpointSecretStore.read()
    返回 null。用户看到的是「列表里明明显示已配置密钥，但每次请求 401」，
    一个纯粹的假象，排查方向会完全错（04-risk-register R11 的触发信号）。
    同一机型上「备份 → 恢复」能解开，这更危险：它让凭据悄悄多了一份可迁移的副本。
  * harness/endpoints.json：端点清单，含 baseUrl / 模型名 / 供应商。
    单独看不是密钥，但它与密文合起来就是「凭据 + 它要访问的地址」的完整包裹。
    旧仓 gallery#1325 的真实事故正是「备份恢复了一份本不该离开设备的配置」。
  * harness/logs/：运行日志。工具参数与结果会进日志（clipboard get 的返回值也在
    其中，见 R21），日志是「已脱敏」而不是「保证不含原文」，不该外带。
  * datastore/：活跃端点 id、界面偏好等。本身不敏感，但它与上面三项构成同一份
    会话配置；只迁一半会出现「端点 id 指向一个没有密钥的端点」，比全不迁更难诊断。

  如实申报：排除 ≠ 加密。这些文件仍在应用私有目录里，root / 调试版仍可读；
  本文件只回答「系统级备份与换机迁移要不要把它们带走」这一个问题。
-->
<data-extraction-rules>
    <!-- 云备份（Auto Backup，Android 12+ 的规则形态） -->
    <cloud-backup>
        <exclude domain="file" path="harness/secrets/" />
        <exclude domain="file" path="harness/endpoints.json" />
        <exclude domain="file" path="harness/logs/" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>

    <!-- 设备间直传（D2D：Google 换机流程与部分 OEM 迁移工具走这条） -->
    <device-transfer>
        <exclude domain="file" path="harness/secrets/" />
        <exclude domain="file" path="harness/endpoints.json" />
        <exclude domain="file" path="harness/logs/" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
