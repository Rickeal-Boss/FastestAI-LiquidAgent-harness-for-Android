<?xml version="1.0" encoding="utf-8"?>
<!--
  出网明文策略（配合 AndroidManifest 的 android:networkSecurityConfig）。

  默认全局禁止明文：minSdk 31 起系统本来就默认禁明文，但那是「默认值」而不是「声明」——
  把 base-config 写死，未来有人把 targetSdk 降到 27 或改 minSdk 也不会静默放开。

  只给三个本地地址开明文，因为本仓唯一合法的明文场景是「宿主机/本机的推理服务」：
  * 10.0.2.2  —— Android 模拟器访问宿主机 loopback 的固定地址（预置 Ollama 端点用它）
  * 127.0.0.1 —— 设备自身 loopback（adb reverse 把宿主机端口映射到设备时走它）
  * localhost —— 同上，给用户手填的写法留一条

  ⚠️ NSC 的 domain 匹配是「主机名字符串相等」，**不支持 IP 段通配**，所以：
  * 真机走局域网 `http://192.168.x.x:11434` 仍会被系统判为明文并拒绝；
    正确姿势是 `adb reverse tcp:11434 tcp:11434` 后用 `http://127.0.0.1:11434/v1`，
    或者给本地服务套一层 https（自签证书需要额外的 trust-anchors 配置，本仓不做）。
  * 这里的三条只解决「模拟器 / adb reverse」两条路径，不代表局域网明文被支持。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
